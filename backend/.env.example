PORT=3000
SITE_ORIGIN=https://noellaabraham.github.io
EDITOR_PASSWORD=replace-with-a-long-random-password
SERVICE_DATA_DIR=/home/ubuntu/oci-open-source-hub-data/services

# Enable only on the production VM; token stays on the backend.
GITHUB_SERVICES_SYNC=false
# Resource/report sync inherits GITHUB_SERVICES_SYNC. Set this only to override:
# GITHUB_CONTENT_SYNC=true
GITHUB_REPOSITORY=NoellaAbraham/oci-open-source-hub
GITHUB_BRANCH=main
GITHUB_TOKEN=
